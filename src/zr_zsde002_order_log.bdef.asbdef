managed implementation in class zbp_r_zsde002_order_log unique;
strict ( 2 );

define behavior for ZR_ZSDE002_ORDER_LOG alias OrderLog
persistent table ztsd_e002_order
lock master
authorization master ( global )
{
  create;

  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  association _ItemLog         { create; }
  association _OrderPricingLog { create; }
  association _OrderMessageLog { create; }
}

define behavior for ZI_ZSDE002_ITEM_LOG alias ItemLog
persistent table ztsd_e002_item
lock dependent by _OrderLog
authorization dependent by _OrderLog
{
  field ( readonly ) OrderUUID, LocalLastChangedAt;

  association _OrderLog;
  association _ItemPricingLog { create; }
}

define behavior for ZI_ZSDE002_ITMPRC_LOG alias ItemPricingLog
persistent table ztsd_e002_itmprc
lock dependent by _OrderLog
authorization dependent by _OrderLog
{
  field ( readonly )        ItemUUID, LocalLastChangedAt;
  field ( readonly:update ) OrderUUID;

  association _ItemLog;
  association _OrderLog;
}

define behavior for ZI_ZSDE002_ORDPRC_LOG alias OrderPricingLog
persistent table ztsd_e002_ordprc
lock dependent by _OrderLog
authorization dependent by _OrderLog
{
  field ( readonly ) OrderUUID, LocalLastChangedAt;

  association _OrderLog;
}

define behavior for ZI_ZSDE002_ORDMSG_LOG alias OrderMessageLog
persistent table ztsd_e002_ordmsg
lock dependent by _OrderLog
authorization dependent by _OrderLog
{
  field ( readonly ) OrderUUID, LocalLastChangedAt;

  association _OrderLog;
}