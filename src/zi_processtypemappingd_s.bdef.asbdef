managed with additional save implementation in class ZBP_I_PROCESSTYPEMAPPINGD_S unique;
strict ( 1 );
with draft;
define behavior for ZI_ProcessTypeMappingD_S alias ProcessTypeMappiAll
draft table ZTSD_PRCS_T_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )
{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare {
    validation ProcessTypeMappingD ~ ValidateDataConsistency;
  }
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _ProcessTypeMappingD { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT
  {
    create;
    update;
  }

  side effects
  {
    action SelectCustomizingTransptReq affects
        $self;
  }

}

define behavior for ZI_ProcessTypeMappingD alias ProcessTypeMappingD ##UNMAPPED_FIELD[SingletonID]
persistent table ZTSD_PRCS_TY
draft table ZTSD_PRCS_TY_D
lock dependent by _ProcessTypeMappiAll
authorization dependent by _ProcessTypeMappiAll
{
  field ( mandatory : create )
   ProcessType;

  field ( readonly )
   SingletonID,
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt;

  field ( readonly : update )
   ProcessType;

  field ( notrigger )
   SingletonID,
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt;


  update( features : global );
  delete( features : global );

  mapping for ZTSD_PRCS_TY
  {
    ProcessType = PROCESS_TYPE;
    Description = DESCRIPTION;
    TranType = TRAN_TYPE;
    SalesOrderType = SALES_ORDER_TYPE;
    SalesOrganization = SALES_ORGANIZATION;
    DistributionChannel = DISTRIBUTION_CHANNEL;
    Division = DIVISION;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
  }

  association _ProcessTypeMappiAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT
  {
    create;
    update;
    delete;
  }
  validation ValidateDataConsistency on save
  {
    create;
    update;
  }

}