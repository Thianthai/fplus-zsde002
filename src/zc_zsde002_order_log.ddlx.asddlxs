@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName:       'Order Log',
    typeNamePlural: 'Order Logs',
    title:       { type: #STANDARD, value: 'SfHeaderIdRef' },
    description: { type: #STANDARD, value: 'SalesOrderNumber' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'CreatedAt', direction: #DESC }] }]
}
annotate entity ZC_ZSDE002_ORDER_LOG
  with
{
  @UI.facet: [
    { id: 'GeneralTab', purpose: #STANDARD, type: #COLLECTION,
      label: 'General Information', position: 10 },

    { id: 'RequestData', parentId: 'GeneralTab', type: #FIELDGROUP_REFERENCE,
      label: 'Request', position: 10, targetQualifier: 'RequestData' },

    { id: 'OrgData', parentId: 'GeneralTab', type: #FIELDGROUP_REFERENCE,
      label: 'Organization', position: 20, targetQualifier: 'OrgData' },

    { id: 'PartnerData', parentId: 'GeneralTab', type: #FIELDGROUP_REFERENCE,
      label: 'Partner', position: 30, targetQualifier: 'PartnerData' },

    { id: 'RefData', parentId: 'GeneralTab', type: #FIELDGROUP_REFERENCE,
      label: 'Reference', position: 40, targetQualifier: 'RefData' },

    { id: 'DateData', parentId: 'GeneralTab', type: #FIELDGROUP_REFERENCE,
      label: 'Dates & Shipping', position: 50, targetQualifier: 'DateData' },

    { id: 'FinData', parentId: 'GeneralTab', type: #FIELDGROUP_REFERENCE,
      label: 'Pricing & Reason', position: 60, targetQualifier: 'FinData' },

    { id: 'BodyFacet', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      label: 'Request Body (JSON)', position: 20, targetQualifier: 'RequestBody' },

    { id: 'ItemFacet', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Items', position: 30, targetElement: '_ItemLog' },

    { id: 'OrderPricingFacet', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Order Pricing', position: 40, targetElement: '_OrderPricingLog' },

    { id: 'OrderMessageFacet', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Messages', position: 50, targetElement: '_OrderMessageLog' }
  ]

  @UI.hidden: true
  OrderUUID;

  @UI: {
    lineItem:       [{ position: 10, importance: #HIGH }],
    selectionField: [{ position: 10 }],
    fieldGroup:     [{ qualifier: 'RequestData', position: 10 }]
  }
  RequestId;

  @UI: {
    multiLineText: true,
    fieldGroup:    [{ qualifier: 'RequestBody', position: 10 }]
  }
  RequestBody;

  @UI: {
    lineItem:       [{ position: 20, importance: #HIGH }],
    selectionField: [{ position: 20 }],
    fieldGroup:     [{ qualifier: 'RefData', position: 10 }]
  }
  SfHeaderIdRef;

  @UI: {
    lineItem:       [{ position: 30, importance: #HIGH }],
    selectionField: [{ position: 30 }],
    fieldGroup:     [{ qualifier: 'RequestData', position: 20 }]
  }
  SalesOrderNumber;

  @UI: {
    lineItem:       [{ position: 40, importance: #HIGH }],
    selectionField: [{ position: 40 }],
    fieldGroup:     [{ qualifier: 'RequestData', position: 30 }]
  }
  OrderStatus;

  @UI.fieldGroup: [{ qualifier: 'RequestData', position: 40 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'RequestData', position: 50 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'OrgData', position: 10 }]
  ProcessType;

  @UI.fieldGroup: [{ qualifier: 'OrgData', position: 20 }]
  TranType;

  @UI: {
    lineItem:   [{ position: 50, importance: #MEDIUM }],
    fieldGroup: [{ qualifier: 'OrgData', position: 30 }]
  }
  SalesOrderType;

  @UI: {
    selectionField: [{ position: 50 }],
    fieldGroup:     [{ qualifier: 'OrgData', position: 40 }]
  }
  SalesOrganization;

  @UI.fieldGroup: [{ qualifier: 'OrgData', position: 50 }]
  DistributionChannel;

  @UI.fieldGroup: [{ qualifier: 'OrgData', position: 60 }]
  Division;

  @UI: {
    lineItem:       [{ position: 60, importance: #MEDIUM }],
    selectionField: [{ position: 60 }],
    fieldGroup:     [{ qualifier: 'PartnerData', position: 10 }]
  }
  SoldToParty;

  @UI.fieldGroup: [{ qualifier: 'PartnerData', position: 20 }]
  CustomerBranch;

  @UI.fieldGroup: [{ qualifier: 'PartnerData', position: 30 }]
  ShipToParty;

  @UI.fieldGroup: [{ qualifier: 'PartnerData', position: 40 }]
  BillToParty;

  @UI.fieldGroup: [{ qualifier: 'PartnerData', position: 50 }]
  Payer;

  @UI.fieldGroup: [{ qualifier: 'PartnerData', position: 60 }]
  StockVan;

  @UI: {
    lineItem:   [{ position: 70, importance: #MEDIUM }],
    fieldGroup: [{ qualifier: 'RefData', position: 20 }]
  }
  CustomerReference;

  @UI.fieldGroup: [{ qualifier: 'RefData', position: 30 }]
  CustomerReferenceDate;

  @UI.fieldGroup: [{ qualifier: 'RefData', position: 40 }]
  SalesOrderTempId;

  @UI.fieldGroup: [{ qualifier: 'RefData', position: 50 }]
  CustomerPO;

  @UI.fieldGroup: [{ qualifier: 'RefData', position: 60 }]
  OriginalSalesDocument;

  @UI.fieldGroup: [{ qualifier: 'RefData', position: 70 }]
  RelatedDocumentReference;

  @UI.fieldGroup: [{ qualifier: 'RefData', position: 80 }]
  TaxDocumentNo;

  @UI.fieldGroup: [{ qualifier: 'RefData', position: 90 }]
  PaymentTransactionReference;

  @UI.fieldGroup: [{ qualifier: 'DateData', position: 10 }]
  DocumentDate;

  @UI.fieldGroup: [{ qualifier: 'DateData', position: 20 }]
  ReqDeliveryDate;

  @UI.fieldGroup: [{ qualifier: 'DateData', position: 30 }]
  ShippingConditions;

  @UI.fieldGroup: [{ qualifier: 'FinData', position: 10 }]
  Currency;

  @UI.fieldGroup: [{ qualifier: 'FinData', position: 20 }]
  PaymentTerm;

  @UI.fieldGroup: [{ qualifier: 'FinData', position: 30 }]
  OrderReason;

  @UI: {
    multiLineText: true,
    fieldGroup:    [{ qualifier: 'FinData', position: 40 }]
  }
  OrderReasonText;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}