@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName:       'Sales Order Creation Log',
    typeNamePlural: 'Sales Order Creation Logs',
    title:       { type: #STANDARD, value: 'SfHeaderIdRef' },
    description: { type: #STANDARD, value: 'CreatedAt' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'SfHeaderIdRef', direction: #ASC }] }]
}
annotate entity ZC_ZSDE002_ORDER_LOG
  with 
{
  @UI.facet: [
    { id: 'OrderTab', purpose: #STANDARD, type: #COLLECTION,
      label: 'General Information', position: 10 },

    { id: 'RequestBody', parentId: 'OrderTab', purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Request Body (JSON)', position: 10 },

    { id: 'OrderData', parentId: 'OrderTab', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'Order Data', position: 20, targetQualifier: 'OrderData' },

    { id: 'AdminData', parentId: 'OrderTab', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'Administrative Data', position: 30, targetQualifier: 'AdminData' },

    /* tab ของ child แต่ละตัว */
    { id: 'ItemFacet', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Items', position: 10, targetElement: '_ItemLog' },

    { id: 'OrderPricingFacet', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Order Pricing', position: 20, targetElement: '_OrderPricingLog' },
      
    { id: 'OrderMessageFacet', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Order Message', position: 30, targetElement: '_OrderMessageLog' }
  ]
  
  @UI.hidden: true
  OrderUUID;
  
  @UI: {
    lineItem:       [{ position: 10, importance: #HIGH }],
    identification: [{ position: 10 }],
    selectionField: [{ position: 10 }],
    fieldGroup: [{ qualifier: 'OrderData', position: 10 }]
  }
  SfHeaderIdRef;
  
  @UI.fieldGroup: [{ qualifier: 'AdminData', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'AdminData', position: 20 }]
  CreatedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}