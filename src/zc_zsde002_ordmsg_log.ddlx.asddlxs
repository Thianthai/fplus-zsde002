@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName:       'Message',
    typeNamePlural: 'Messages',
    title:       { type: #STANDARD, value: 'Status' },
    description: { type: #STANDARD, value: 'MessageArea' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'MsgSeq', direction: #ASC }] }]
}
annotate entity ZC_ZSDE002_ORDMSG_LOG
  with
{
  @UI.facet: [
    { id: 'OrderMessage', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
      label: 'Message', position: 10 }
  ]

  @UI.hidden: true
  OrderMessageUUID;

  @UI.hidden: true
  OrderUUID;

  @UI: {
    lineItem:       [{ position: 10, importance: #HIGH }],
    identification: [{ position: 10 }]
  }
  MsgSeq;

  @UI: {
    lineItem:       [{ position: 20, importance: #HIGH }],
    identification: [{ position: 20 }]
  }
  MessageArea;

  @UI: {
    lineItem:       [{ position: 30, importance: #HIGH }],
    identification: [{ position: 30 }]
  }
  Status;

  @UI: {
    lineItem:       [{ position: 40, importance: #HIGH }],
    multiLineText:  true,
    identification: [{ position: 40 }]
  }
  Message;
}